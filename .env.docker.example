# Copy to .env.docker and fill in. Used by docker-compose.yml.
NODE_ENV=production
JWT_SECRET=                      # openssl rand -base64 48
CORS_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com
PUBLIC_MEDIA_URL=https://api.example.com/uploads
PAYMENT_PROVIDER=simulated
ALLOW_SIMULATED_PAYMENTS=true    # simulated approves every payment: demo/staging only
SMTP_URL=smtp://user:pass@smtp.example.com:587
MAIL_FROM="Tourista Rwanda <no-reply@example.com>"
TRUST_PROXY=1
