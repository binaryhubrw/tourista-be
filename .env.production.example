# Server .env for docker-compose.prod.yml. MONGODB_URI, PORT and UPLOAD_DIR are set by compose.
IMAGE_TAG=production
API_PORT=8010

NODE_ENV=production
JWT_SECRET=                      # openssl rand -base64 48
JWT_EXPIRES_IN=7d
CORS_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com
PUBLIC_MEDIA_URL=https://app.example.com/uploads
TRUST_PROXY=1

PAYMENT_PROVIDER=simulated
ALLOW_SIMULATED_PAYMENTS=true    # simulated approves every payment; required until a real provider exists
STORAGE_DRIVER=disk

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Tourista Rwanda <no-reply@example.com>"
