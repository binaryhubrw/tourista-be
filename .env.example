NODE_ENV=development
PORT=8000
MONGODB_URI=mongodb://localhost:27017/tourista?replicaSet=rs0
JWT_SECRET=change-me                   # production: >= 32 random chars (openssl rand -base64 48)
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173     # comma-separated allow-list
FRONTEND_URL=http://localhost:5173
DEFAULT_USER_PASSWORD=password         # dev only; leave unset in production
PAYMENT_PROVIDER=simulated
ALLOW_SIMULATED_PAYMENTS=false         # must be true to use simulated when NODE_ENV=production
STORAGE_DRIVER=disk                    # disk | s3 (s3 not implemented yet)
UPLOAD_DIR=./uploads
PUBLIC_MEDIA_URL=http://localhost:8000/uploads
SMTP_URL=                              # empty -> emails are not sent (logged without body)
MAIL_FROM="Tourista Rwanda <no-reply@tourista.rw>"
TRUST_PROXY=1                          # number of reverse proxies in front of the API
LOG_LEVEL=                             # fatal|error|warn|info|debug|trace|silent (default by NODE_ENV)
RATE_LIMIT_PER_MIN=300                 # per IP across /api; /auth/* has its own 10/min limit
ALLOW_PRODUCTION_SEED=false            # demo seed is refused in production unless true
